# Copy this file to .env and fill in real values. Never commit .env.
# adogap loads this automatically via python-dotenv if present in the CWD.

# Azure DevOps
ADO_ORGANIZATION=my-ado-org
ADO_PROJECT=PaymentsPlatform
ADO_PAT=changeme
ADO_INSTANCE_URL=https://dev.azure.com

# GitHub (used only for verification lookups / environment scaffolding hints;
# adogap never writes to GitHub directly — it only generates gh CLI commands
# and JSON/YAML artifacts for a human to review and apply)
GITHUB_ORG=my-github-org
GITHUB_INSTANCE_URL=https://github.com

# Tuning
ADOGAP_MAX_RETRIES=5
ADOGAP_INITIAL_BACKOFF_SECONDS=10
ADOGAP_MAX_CONCURRENCY=3
ADOGAP_MIN_REQUEST_INTERVAL_SECONDS=1.0
